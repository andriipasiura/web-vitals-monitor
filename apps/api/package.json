{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "pnpm run \"/^dev:/\"",
    "dev:api": "nest start --watch",
    "dev:worker": "nest start --watch --entryFile worker -p tsconfig.worker.json",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --project e2e",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env ./node_modules/drizzle-kit/bin.cjs migrate",
    "seed": "nest build && node --env-file-if-exists=.env dist/scripts/seed.js",
    "perf": "nest build && node --env-file-if-exists=.env dist/scripts/perf.js",
    "loadtest": "nest build && node --env-file-if-exists=.env dist/scripts/load-test.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^12.0.1",
    "@node-rs/argon2": "^2.2.2",
    "@rum/shared": "workspace:*",
    "bullmq": "6.3.15",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/autocannon": "^7.12.7",
    "@types/express": "^5.0.0",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "autocannon": "^8.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "catalog:",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "supertest": "^7.0.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.72.0",
    "vitest": "catalog:"
  }
}
