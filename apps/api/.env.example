PORT=3001
# If port 5432 is taken locally, run compose with POSTGRES_PORT=5433 and change the port here.
DATABASE_URL=postgres://rum:rum@localhost:5432/rum
# At least 32 characters. Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
DASHBOARD_ORIGIN=http://localhost:3000
# Secure cookies need HTTPS; keep false only for local http development.
COOKIE_SECURE=false
